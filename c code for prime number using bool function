#include <stdio.h>
#include <stdbool.h>  // For using 'bool', 'true', and 'false'

bool is_prime(int number) {
    if (number <= 1) {  // Numbers <= 1 are not prime
        return false;
    }
    for (int i = 2; i < number; i++) {  // Check divisibility from 2 to (number - 1)
        if (number % i == 0) {  // If divisible, it's not prime
            return false;
        }
    }
    return true;  // If no divisor found, it's prime
}

int main() {
    int num;
    printf("Enter a number: ");
    scanf("%d", &num);

    if (is_prime(num)) {
        printf("%d is a prime number.\n", num);
    } else {
        printf("%d is not a prime number.\n", num);
    }

    return 0;
}
